
# Local .terraform directories
**/.terraform/*

# Terraform lock file is intentionally committed for reproducible providers
# (do not ignore .terraform.lock.hcl)

# .tfstate files (state lives in Terraform Cloud, never commit local state)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Any local .tfvars files that may contain sensitive/environment-specific values
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc
